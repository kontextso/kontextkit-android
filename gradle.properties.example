# KontextKit Android — local publishing credentials template.
#
# Do NOT commit a populated copy of this file. Either:
#   - Create ~/.gradle/gradle.properties with these keys (preferred for
#     local publishing), OR
#   - Pass each key on the command line via -P (used by CI; see
#     .github/workflows/publish.yml).
#
# Sonatype / Maven Central account
# https://central.sonatype.com → User Token → "Generate User Token"
mavenCentralUsername=
mavenCentralPassword=

# GPG signing — ASCII-armored private key, exported as a single line.
# Generate / export with:
#   gpg --armor --export-secret-keys <KEY_ID> | awk 'NR==1 {printf "%s",$0; next} /^-----END/ {printf "\\n%s\\n",$0; exit} {printf "\\n%s",$0}'
signingInMemoryKey=
signingInMemoryKeyPassword=
# Optional: if you have multiple keys, the 8-char short key id.
# signingInMemoryKeyId=

# Override the default version (kit = ... in gradle/libs.versions.toml).
# CI sets this from the git tag; locally pass `-PkitVersion=X.Y.Z`.
# kitVersion=0.0.1
